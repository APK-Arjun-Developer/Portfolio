# UI theme to build: "classic" (original dark glass design, default), "signal" (Coral Signal)
# or "terminal" (warm paper, doors and pull cord).
# Read at build time — restart `npm run dev` / rebuild after changing it.
VITE_UI_THEME=classic

# Google Analytics 4
VITE_GA_ENABLED=false
VITE_GA_MEASUREMENT_ID=
